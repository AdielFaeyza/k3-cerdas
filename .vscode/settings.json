{
  "python.defaultInterpreterPath": "${workspaceFolder}/edge/.venv/bin/python",
  "python.analysis.extraPaths": ["${workspaceFolder}/edge"],
  "python.testing.unittestEnabled": true,
  "python.testing.unittestArgs": ["-s", "edge/tests", "-t", "edge"],
  "editor.formatOnSave": true,
  "[python]": { "editor.tabSize": 4 },
  "[php]": { "editor.tabSize": 4 },
  "[javascriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "files.exclude": {
    "**/__pycache__": true,
    "**/node_modules": true,
    "**/.venv": true
  }
}
